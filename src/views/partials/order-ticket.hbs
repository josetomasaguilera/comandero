<section class="ticket" tabindex="-1" aria-labelledby="order-summary-title">
  <h2 id="order-summary-title">Pedido</h2>
  <ul id="ticket-items" class="ticket-items">
    {{#each order.items}}
    <li class="ticket-item ticket-item--{{this.status}}">
      <span class="ticket-item__qty">{{this.quantity}}x</span>
      <div class="ticket-item__description">
      <span class="ticket-item__name">{{this.product.name}}</span>
      {{#if this.notes}}<span class="ticket-item__notes">({{this.notes}})</span>{{/if}}
      {{#if this.extrasCents}}<span class="ticket-item__notes">Extras: +{{extrasPrice this.extrasCents}} por unidad</span>{{/if}}
      </div>
      <div class="ticket-item__controls">
      <span class="ticket-item__status">{{this.status}}</span>
      <form data-order-quantity action="/tables/{{../table.id}}/order/items/{{this.id}}/decrementar" method="post">
        <button type="submit" class="button button--small button--secondary" title="Quitar 1 unidad" {{#if (eq this.status "listo")}}disabled{{/if}}>-1</button>
      </form>
      <form data-order-quantity action="/tables/{{../table.id}}/order/items/{{this.id}}/incrementar" method="post">
        <button type="submit" class="button button--small" title="Añadir 1 unidad" {{#if (eq this.status "listo")}}disabled{{/if}}>+1</button>
      </form>
      </div>
    </li>
    {{/each}}
  </ul>
  <div class="ticket-total">Total: {{total order.items}}</div>
  <div class="ticket-actions">
    <form action="/tables/{{table.id}}/order/cerrar" method="post">
      <button type="submit" class="button button--danger">Cerrar mesa y cobrar</button>
    </form>
    <form action="/tables/{{table.id}}/order/{{order.id}}/cancelar" method="post">
      <button type="submit" class="button button--secondary">Cancelar</button>
    </form>
  </div>
</section>
