<!DOCTYPE html>
<html lang="es">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
{{> nav}}
<main class="container">
  <p><a href="/admin/products{{#if selectedCategoryId}}?categoryId={{selectedCategoryId}}{{/if}}">&larr; Productos</a></p>
  <h1>{{title}}</h1>
  <form class="admin-form" action="{{#if product}}/admin/products/{{product.id}}{{else}}/admin/products{{/if}}" method="post" enctype="multipart/form-data">
    <input type="hidden" name="selectedCategoryId" value="{{selectedCategoryId}}">
    <label>Nombre
      <input type="text" name="name" value="{{product.name}}" required>
    </label>
    <label>Precio
      <input type="text" name="price" inputmode="decimal" value="{{product.price}}" pattern="[0-9]+([.,][0-9]{1,2})?" title="Importe no negativo con hasta dos decimales" required>
    </label>
    <label>Coste por unidad (€)
      <input type="text" name="cost" inputmode="decimal" value="{{#if product.cost}}{{product.cost}}{{else}}0{{/if}}" pattern="[0-9]+([.,][0-9]{1,2})?" title="Importe no negativo con hasta dos decimales">
    </label>
    <label>Categoría
      <select name="categoryId" required>
        {{#each categories}}
        <option value="{{this.id}}" {{#if (eq this.id ../formCategoryId)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="active" {{#if product.active}}checked{{/if}}>
      Activo
    </label>
    <label>Foto
      {{#if product.imageUrl}}
      <img class="image-preview" src="{{product.imageUrl}}" alt="">
      {{/if}}
      <input type="file" name="image" accept="image/*">
    </label>
    <button type="submit">Guardar</button>
  </form>
</main>
</body>
</html>
