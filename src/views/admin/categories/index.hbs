<!DOCTYPE html>
<html lang="es">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
{{> nav}}
<main class="container">
  <p><a href="/admin">&larr; Administración</a></p>
  <h1>Categorías</h1>
  <a class="button" href="/admin/categories/new">Nueva categoría</a>
  <div class="table-scroll" role="region" aria-label="Categorías" tabindex="0">
  <table class="admin-table">
    <thead>
      <tr><th>Foto</th><th>Nombre</th><th>Destino</th><th>Orden</th><th></th></tr>
    </thead>
    <tbody>
      {{#each categories}}
      <tr>
        <td>{{#if this.imageUrl}}<img class="thumb" src="{{this.imageUrl}}" alt="">{{/if}}</td>
        <td>{{this.name}}</td>
        <td>{{this.destination}}</td>
        <td>{{this.order}}</td>
        <td>
          <a href="/admin/categories/{{this.id}}/edit">Editar</a>
          <form action="/admin/categories/{{this.id}}/delete" method="post" style="display:inline">
            <button type="submit" class="link-button">Eliminar</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  </div>
</main>
</body>
</html>
