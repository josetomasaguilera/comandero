<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
{{> nav}}
<main class="container">
  <a href="/tables">&larr; Mesas</a>
  <h1>Órdenes cerradas</h1>
  <p>Las últimas 50 órdenes, de más reciente a más antigua.</p>
  {{#if orders.length}}
  <div class="table-scroll" role="region" aria-label="Órdenes cerradas" tabindex="0">
    <table class="admin-table">
      <thead><tr><th>Orden</th><th>Mesa</th><th>Cierre</th><th></th></tr></thead>
      <tbody>
        {{#each orders}}
        <tr>
          <td>#{{this.id}}</td>
          <td>{{#if this.table}}{{this.table.name}}{{else}}Mesa #{{this.tableId}}{{/if}}</td>
          <td>{{formatDate this.closedAt}}</td>
          <td><a href="/orders/closed/{{this.id}}">Ver detalle</a></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}<p>Todavía no hay órdenes cerradas.</p>{{/if}}
</main>
</body>
</html>
