<!DOCTYPE html>
<html lang="es">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
{{> nav}}
<main class="container">
  <div class="kitchen-header">
    <h1>Cocina</h1>
  </div>
  <div class="kitchen-board">
    {{#each tables}}
    <section class="kitchen-ticket">
      <h2>{{this.tableName}}</h2>
      <ul>
        {{#each this.items}}
        <li class="kitchen-item">
          <span class="kitchen-item__qty">{{this.quantity}}x</span>
          <span class="kitchen-item__name">{{this.product.name}}</span>
          {{#if this.notes}}<span class="kitchen-item__notes">({{this.notes}})</span>{{/if}}
          <form action="/kitchen/items/{{this.id}}/listo" method="post">
            <button type="submit" class="button button--small">Listo</button>
          </form>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
    {{#unless tables.length}}
    <p>No hay pedidos pendientes en cocina.</p>
    {{/unless}}
  </div>
</main>
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  let audioContext;
  const AudioContextClass = window.AudioContext || window.webkitAudioContext;

  function prepareSound() {
    if (!AudioContextClass) return;
    try {
      if (!audioContext || audioContext.state === 'closed') {
        audioContext = new AudioContextClass();
      }
      if (audioContext.state !== 'running') {
        audioContext.resume().catch(() => {});
      }
    } catch {
      // Keep alerts enabled and retry on the next user interaction.
    }
  }

  function playKitchenSound(type) {
    prepareSound();
    if (!audioContext) return;
    const startTone = () => {
      const isNewOrder = type === 'new';
      const notes = isNewOrder
        ? [660, 880, 1047, 1319]
        : [440, 330, 220];
      const interval = isNewOrder ? 0.16 : 0.2;
      const duration = isNewOrder ? 0.2 : 0.26;
      const volume = isNewOrder ? 0.2 : 0.14;

      notes.forEach((frequency, index) => {
        const offset = index * interval;
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();
        oscillator.type = isNewOrder ? 'square' : 'triangle';
        oscillator.frequency.value = frequency;
        gain.gain.setValueAtTime(volume, audioContext.currentTime + offset);
        gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + offset + duration);
        oscillator.connect(gain).connect(audioContext.destination);
        oscillator.start(audioContext.currentTime + offset);
        oscillator.stop(audioContext.currentTime + offset + duration);
      });
    };

    if (audioContext.state !== 'running') {
      audioContext.resume().then(() => {
        if (audioContext.state === 'running') startTone();
      }).catch(() => {});
      return;
    }
    startTone();
  }

  document.addEventListener('click', prepareSound);
  document.addEventListener('touchend', prepareSound, { passive: true });
  document.addEventListener('keydown', prepareSound);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) prepareSound();
  });
  prepareSound();
  socket.emit('join', { barId: {{currentBar.id}}, role: 'kitchen' });
  socket.on('kitchen:newItems', () => {
    playKitchenSound('new');
    window.setTimeout(() => window.location.reload(), 800);
  });
  socket.on('kitchen:itemsUpdated', () => {
    playKitchenSound('removed');
    window.setTimeout(() => window.location.reload(), 700);
  });
</script>
</body>
</html>
