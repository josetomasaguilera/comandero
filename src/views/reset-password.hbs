<!DOCTYPE html>
<html lang="es">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8">
  <meta name="referrer" content="no-referrer">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="login-page">
  <form class="login-form" action="/reset-password" method="post">
    <h1>Nueva contraseña</h1>
    {{#if invalid}}
    <p class="error" role="alert">El enlace no es válido, ha caducado o ya se ha utilizado.</p>
    <p><a href="/forgot-password">Solicitar un nuevo enlace</a></p>
    {{else}}
    {{#if error}}<p class="error" role="alert">{{error}}</p>{{/if}}
    <input type="hidden" name="token" value="{{token}}">
    <label>Nueva contraseña
      <input type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required autofocus>
    </label>
    <label>Repite la contraseña
      <input type="password" name="passwordConfirmation" minlength="8" maxlength="72" autocomplete="new-password" required>
    </label>
    <button type="submit">Guardar contraseña</button>
    {{/if}}
    <p class="login-form__register"><a href="/login">Volver a iniciar sesión</a></p>
  </form>
</div>
</body>
</html>
